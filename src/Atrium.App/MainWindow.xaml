<Window
    x:Class="Atrium.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Atrium.App.ViewModels"
    mc:Ignorable="d"
    Title="Atrium">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*" DataContext="{x:Bind ViewModel}">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter xmlns:converters="using:Atrium.App.Converters" x:Key="BoolToVisibility" />
        </Grid.Resources>
        <!-- Custom Title Bar Area -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="48" Background="Transparent" SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCaptionInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightCaptionInset" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,16,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Atrium" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Quick Sync Button in Title Bar -->
            <StackPanel Grid.Column="2" x:Name="TitleBarActions" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                <Button Padding="8,4" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.SyncLibraryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock Text="Sync" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Content="Cancel" Padding="8,4" Command="{x:Bind ViewModel.SourcesVM.CancelSyncCommand}"
                        Visibility="{Binding SourcesVM.IsSyncing, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- Main Navigation Shell -->
        <NavigationView Grid.Row="1"
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="LeftCompact"
                        OpenPaneLength="216"
                        CompactPaneLength="52"
                        IsPaneOpen="False"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Library" Tag="Library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Launchers &amp; Sources" Tag="Sources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="GPU &amp; Graphics" Tag="GpuOptimizer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Margin="0,0,0,0"/>
        </NavigationView>
    </Grid>
</Window>
