<Page
    x:Class="Atrium.App.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Atrium.App.ViewModels"
    xmlns:converters="using:Atrium.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24">
            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Launchers &amp; Game Sources" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Atrium dynamically discovers your local libraries without requiring private API tokens."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Global Sync Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}" 
                                  Visibility="{x:Bind ViewModel.IsSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                  Width="24" Height="24"/>

                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SyncAllCommand}"
                            IsEnabled="{x:Bind ViewModel.IsSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Sync Entire Library"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LastSyncDurationText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Launcher Cards List -->
            <TextBlock Text="Detected Gaming Platforms" FontSize="18" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Launchers, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LauncherItem">
                        <Border Margin="0,0,0,12" 
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16">
                            <Grid ColumnDefinitions="48,*,Auto">
                                <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="Bold" FontSize="16"/>
                                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind GameCount}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind StatusDescription}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{x:Bind IsDetected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Bind IsDetected}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom Folders Section -->
            <TextBlock Text="Custom Local Game Folders" FontSize="18" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Configure standalone folders where games or DRM-free titles are installed." 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="NewFolderInput" PlaceholderText="e.g. D:\Games or C:\RetroGames"/>
                        <Button Grid.Column="1" Content="Add Folder" Click="OnAddFolderClicked"/>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.CustomFolders, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                    <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Remove" Click="OnRemoveFolderClicked" Tag="{x:Bind}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
