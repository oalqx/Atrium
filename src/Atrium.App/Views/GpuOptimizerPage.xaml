<Page
    x:Class="Atrium.App.Views.GpuOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Atrium.App.ViewModels"
    xmlns:converters="using:Atrium.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="GPU &amp; Graphics Optimizer" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Intelligently enforces your discrete high-performance GPU for games with zero risk and one-click rollback."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Hardware Specs Banner -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <!-- Discrete GPU Card -->
                <Border Grid.Column="0" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="DISCRETE GPU" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.DiscreteGpuName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.DiscreteVramText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Integrated GPU Card -->
                <Border Grid.Column="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="INTEGRATED GPU" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.IntegratedGpuName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Power-saving display adapter" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- CPU & RAM Card -->
                <Border Grid.Column="2" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROCESSOR &amp; RAM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RamText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Display Card -->
                <Border Grid.Column="3" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PRIMARY DISPLAY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.DisplayText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Native Resolution &amp; Refresh" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Optimization Actions Panel -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Intelligent GPU Enforcement" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Sets DirectX UserGpuPreferences to force your discrete GPU for all installed game binaries. Original settings are backed up locally in SQLite."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="Revert All"
                            Command="{x:Bind ViewModel.RevertAllCommand}"
                            VerticalAlignment="Center"/>

                    <Button Grid.Column="2" 
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OptimizeAllGamesCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="Optimize All Games"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Installed Games List -->
            <TextBlock Text="Installed Games GPU Status" FontSize="18" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledGameItems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameGpuItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" Padding="8,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ExePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <TextBlock Text="High-Performance GPU" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ToggleSwitch IsOn="{x:Bind IsHighPerformance, Mode=OneWay}" 
                                                  Toggled="OnToggleSwitchToggled"
                                                  Tag="{x:Bind}"
                                                  OnContent="" OffContent=""/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
