<Page
    x:Class="Atrium.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Atrium.App.ViewModels"
    xmlns:converters="using:Atrium.App.Converters"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchShortcut" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeShortcut" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:PlaytimeFormatterConverter x:Key="PlaytimeConverter" />
        <converters:StoreBadgeConverter x:Key="StoreBadgeConverter" />
        <converters:StoreNameConverter x:Key="StoreNameConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:FavoriteBrushConverter x:Key="FavoriteBrushConverter" />
        <converters:ArtworkImageConverter x:Key="ArtworkImageConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,*" SizeChanged="OnLibrarySizeChanged">
        <!-- Header Controls Bar -->
        <ContentControl Grid.Row="0" Margin="24,16,24,16" HorizontalContentAlignment="Stretch"
              IsEnabled="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay, Converter={StaticResource InverseBool}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search and Controls -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <!-- Search Box -->
                <TextBox Grid.Column="0" 
                         x:Name="SearchBox"
                         HorizontalAlignment="Stretch"
                         AutomationProperties.Name="Search games"
                         PlaceholderText="Search games..."
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <TextBlock Text="Search" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </TextBox.Header>
                </TextBox>

                <!-- Filter Combo -->
                <ComboBox Grid.Column="1" x:Name="FilterBox"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.FilterOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}">
                    <ComboBox.Header>
                        <TextBlock Text="Show" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </ComboBox.Header>
                </ComboBox>

                <!-- Sort Combo -->
                <ComboBox Grid.Column="2" x:Name="SortBox"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}">
                    <ComboBox.Header>
                        <TextBlock Text="Sort By" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </ComboBox.Header>
                </ComboBox>
                <ComboBox Grid.Column="3" x:Name="CollectionBox" Header="Collection" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.CollectionOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=OneWay}"
                          SelectionChanged="OnCollectionSelectionChanged" />
            </Grid>

            <!-- Status & Summary Bar -->
            <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Clear filters" Command="{x:Bind ViewModel.ResetFiltersCommand}"
                        Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="2" Content="Reload" Command="{x:Bind ViewModel.LoadGamesCommand}" />
                <!-- Loading indicator -->
                <ProgressBar Grid.Column="0"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,4,0,0"
                             IsIndeterminate="True" Width="120"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>
        </ContentControl>

        <!-- Games Grid -->
            <GridView Grid.Row="1" Padding="20,0,20,24"
                      x:Name="GamesGrid"
                      ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}"
                      SelectionMode="None"
                      IsEnabled="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay, Converter={StaticResource InverseBool}}"
                      IsItemClickEnabled="True"
                      ItemClick="OnGameClicked">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <Grid Width="170" Height="255" Margin="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <!-- Poster Art -->
                            <Image Source="{x:Bind CoverUri, Mode=OneWay, Converter={StaticResource ArtworkImageConverter}}"
                                   Tag="{x:Bind}"
                                   ImageFailed="OnCoverImageFailed"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind HasCover, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Fallback Gradient Tile if no cover art -->
                            <Border Visibility="{x:Bind HasCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    Padding="12">
                                <TextBlock Text="{x:Bind Title}" 
                                           TextWrapping="Wrap" 
                                           FontSize="15" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>

                            <!-- Gradient Vignette at Bottom for readability -->
                            <Border VerticalAlignment="Bottom" Height="80">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                        <GradientStop Color="#CC000000" Offset="0.7"/>
                                        <GradientStop Color="#F0000000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Top Badges Bar: Favorite & Installed -->
                            <Grid VerticalAlignment="Top" Margin="6" ColumnDefinitions="Auto,*,Auto">
                                <!-- Favorite Star Button -->
                                <Button Grid.Column="0"
                                        Padding="4"
                                        CornerRadius="4"
                                        Background="#80000000"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        ToolTipService.ToolTip="{x:Bind FavoriteActionLabel, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind FavoriteActionLabel, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE734;" 
                                              FontSize="12" 
                                              Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteBrushConverter}}"/>
                                </Button>

                                <!-- Installed Indicator Pill -->
                                <Border Grid.Column="2"
                                        Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        Background="#107C10"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="Installed" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Bottom Title and Store Badge -->
                            <Grid VerticalAlignment="Bottom" Margin="8,0,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{x:Bind Title}" 
                                           FontWeight="SemiBold" 
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" 
                                           MaxLines="1"
                                           Foreground="White"/>

                                <Grid Grid.Row="1" Margin="0,3,0,0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind PrimaryStoreName, Mode=OneWay}"
                                               FontSize="11" 
                                               Foreground="#CCCCCC"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind PlaytimeMinutes, Converter={StaticResource PlaytimeConverter}}"
                                               FontSize="10"
                                               Foreground="#AAAAAA"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    x:Name="EmptyPanel"
                    MaxWidth="380" Margin="24" Spacing="12"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE7FC;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Clear filters" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ResetFiltersCommand}"
                    Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Artwork-led launch view; Library filters and scroll position stay underneath. -->
        <Grid Grid.RowSpan="2" x:Name="DetailsOverlay" RequestedTheme="Dark"
              Visibility="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
              Background="#101018" SizeChanged="OnLaunchViewSizeChanged">
            <Grid x:Name="DetailsCard">
                <ScrollViewer x:Name="LaunchScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LaunchSurface" Background="#101018" Spacing="24">
                        <Grid x:Name="LaunchHero" MinHeight="380">
                            <Image x:Name="LaunchBackdrop"
                                   Source="{x:Bind ViewModel.SelectedGame.BackgroundUri, Mode=OneWay, Converter={StaticResource ArtworkImageConverter}}"
                                   Stretch="UniformToFill" Opacity="0.62" ImageFailed="OnBackdropImageFailed" ImageOpened="OnBackdropImageOpened" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F2101018" Offset="0" />
                                        <GradientStop Color="#A0101018" Offset="0.55" />
                                        <GradientStop Color="#60101018" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00101018" Offset="0.2" />
                                        <GradientStop x:Name="HeroFadeStop" Color="#FF101018" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Button x:Name="DetailsCloseButton" Margin="24,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#40000000" BorderBrush="#20FFFFFF" Padding="12,8" CornerRadius="8"
                                    Command="{x:Bind ViewModel.CloseDetailsCommand}" AutomationProperties.Name="Back to library"
                                    ToolTipService.ToolTip="Back to library (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                    <TextBlock Text="Library" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Grid x:Name="HeroContent" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="20" Margin="32,88,32,36">
                                <Border x:Name="LaunchPoster" Width="180" Height="270" VerticalAlignment="Top" CornerRadius="10"
                                        Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{x:Bind ViewModel.SelectedGame.CoverUri, Mode=OneWay, Converter={StaticResource ArtworkImageConverter}}"
                                               Tag="{x:Bind ViewModel.SelectedGame, Mode=OneWay}" Stretch="UniformToFill" ImageFailed="OnCoverImageFailed"
                                               Visibility="{x:Bind ViewModel.SelectedGame.HasCover, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel VerticalAlignment="Center" Margin="16" Spacing="14"
                                                    Visibility="{x:Bind ViewModel.SelectedGame.HasCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="#A0FFFFFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGame.Title, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" x:Name="LaunchIdentity" VerticalAlignment="Center" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="LaunchEyebrow" Text="YOUR LIBRARY" CharacterSpacing="160" FontSize="10" FontWeight="Bold" Foreground="#7ED0C1" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.InstallationStatus, Mode=OneWay}" FontSize="11" Foreground="#BFFFFFFF" />
                                    </StackPanel>
                                    <TextBlock x:Name="LaunchGameTitle" Text="{x:Bind ViewModel.SelectedGame.Title, Mode=OneWay}"
                                               FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Foreground="White" />
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="28" Margin="0,0,0,4">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="PLAYTIME" CharacterSpacing="100" FontSize="10" Foreground="#A0FFFFFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGame.PlaytimeMinutes, Mode=OneWay, Converter={StaticResource PlaytimeConverter}}"
                                                       FontSize="17" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="LAST PLAYED" CharacterSpacing="100" FontSize="10" Foreground="#A0FFFFFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGame.LastPlayedText, Mode=OneWay}" FontSize="13" Foreground="#DFFFFFFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="LaunchButton" HorizontalAlignment="Left" CornerRadius="8" Padding="24,13"
                                            Background="#7ED0C1" Foreground="Black" BorderThickness="0"
                                            Command="{x:Bind ViewModel.SelectedGame.LaunchCommand, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE768;" FontSize="15" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGame.LaunchActionLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.ActionMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" Foreground="White"
                                               AutomationProperties.LiveSetting="Polite"
                                               Visibility="{x:Bind ViewModel.SelectedGame.HasActionMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="LaunchBodyGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20" Margin="32,0,32,32">
                            <Border x:Name="LaunchSourcesCard" CornerRadius="12" Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="24">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="Launchers" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Open another copy without changing your preference." FontSize="12" Foreground="#AFFFFFFF" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="LaunchSourcesList" ItemsSource="{x:Bind ViewModel.SelectedGame.LaunchSources, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LaunchSourceOption">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                                                    <Border Width="36" Height="36" CornerRadius="8" Background="#12FFFFFF" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#D0FFFFFF" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Status}" FontSize="11" Foreground="#A0FFFFFF" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Open" Tag="{x:Bind Source}" Click="OnSourceLaunchClicked" VerticalAlignment="Center"
                                                            AutomationProperties.Name="{x:Bind Label}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox x:Name="LaunchPreferenceBox" Header="Default launcher" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.SelectedGame.StorePreferences, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedGame.PendingStorePreference, Mode=OneWay}"
                                                  DisplayMemberPath="Label" IsEnabled="{x:Bind ViewModel.SelectedGame.CanEdit, Mode=OneWay}"
                                                  SelectionChanged="OnPreferenceSelectionChanged" />
                                        <Button Grid.Column="1" Content="Save" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SelectedGame.SavePreferredStoreCommand, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" x:Name="LaunchOrganizeCard" CornerRadius="12" Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="24">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="Make it yours" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                                    <StackPanel Spacing="8">
                                        <Button Content="{x:Bind ViewModel.SelectedGame.FavoriteActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectedGame.ToggleFavoriteCommand, Mode=OneWay}" />
                                        <Button Content="{x:Bind ViewModel.SelectedGame.HideActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectedGame.ToggleHiddenCommand, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox x:Name="CollectionNameBox" Header="Collections" PlaceholderText="Co-op, Backlog, Weekend…" MaxLength="80"
                                                     IsEnabled="{x:Bind ViewModel.SelectedGame.CanEdit, Mode=OneWay}"
                                                     DataContext="{x:Bind ViewModel.SelectedGame, Mode=OneWay}"
                                                     Text="{Binding CollectionDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnCollectionNameKeyDown" />
                                            <Button Grid.Column="1" Content="Add" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SelectedGame.AddCollectionCommand, Mode=OneWay}" />
                                        </Grid>
                                        <ItemsControl x:Name="GameCollectionsList" ItemsSource="{x:Bind ViewModel.SelectedGame.Collections, Mode=OneWay}"
                                                      IsEnabled="{x:Bind ViewModel.SelectedGame.CanEdit, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#DFFFFFFF" />
                                                        <Button Grid.Column="1" Content="Remove" Tag="{Binding}" Click="OnRemoveCollectionClicked" Padding="8,4" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Add a group, then find it using the Library collection filter." FontSize="12" Foreground="#A0FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
